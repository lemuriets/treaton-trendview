{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "System": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Level:u3}] ({Timestamp:yyyy-MM-dd HH:mm:ss}) {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/.log",
                    "rollingInterval": "Infinite",
                    "outputTemplate": "[{Level:u3}] ({Timestamp:yyyy-MM-dd HH:mm:ss}) {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    }
}